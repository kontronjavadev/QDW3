<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
	version="3.0">
	<persistence-unit name="_default" >
		<jta-data-source>java:jboss/datasources/QdwDS</jta-data-source>
		<class>net.sourceforge.jbizmo.commons.jpa.converter.UUIDByteArrayConverter</class>
		<class>net.sourceforge.jbizmo.commons.jpa.converter.UUIDStringConverter</class>
		<properties>
<!-- nein, wir verwenden Hibernate, nicht eclipselink - wie auch immer das zustande kam. -->
			<property name="eclipselink.id-validation" value="NULL"/>
			<property name="eclipselink.cache.shared.default" value="false"/>

			<property name="eclipselink.jdbc.fetch-size" value="1000"/>
			<property name="org.hibernate.fetchSize" value="1000"/>

			<property name="hibernate.jdbc.batch_size" value="1000"/>
			<property name="hibernate.order_inserts" value="true"/>
			<property name="hibernate.order_updates" value="true"/>
		</properties>
	</persistence-unit>
</persistence>